*-backup.html
*.backup.*
.playwright-cli/
.playwright-mcp/
.tmp-*
docs/Temp/

# Local OCR test data, model weights, and comparison run outputs (multi-GB,
# not redistributable; see docs for how to regenerate or download them)
OCR-Model/
Formula-TestSet/
OCR-test-image/
.comparison-old/
comparison-*/

# Local build / model-download artifacts at the repository root
/target/

# rapid-ocr-rs is a separate repository with its own remote; src-tauri depends on
# it by path, so clone it alongside this repository (or convert it to a submodule).
# Only that repo is ignored: our own crates live next to it under `crates/`
# (`crates/snapclip-*`) and a bare `crates/` would keep them out of every commit.
/crates/rapid-ocr-rs/
# Generated by subfont/subset.ps1 (the drawn-text list comes from win/d2d.rs)
subfont/drawn-text.txt

# Python bytecode from the subfont tooling
subfont/__pycache__/
